VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Eldermin ERP

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX, from GA Admin
# > Data Streams > your web stream). Public by design - embedded in every
# page's source, same as on any GA-tracked site. Leave unset to disable
# analytics entirely (index.html's gtag snippet is a no-op without it).
# The matching Property ID (a different, numeric value) and the visitor
# metrics this powers in Super Admin > Analytics & Reports are configured
# separately on the backend - see eldermin-backend's .env.example.
VITE_GA4_MEASUREMENT_ID=
